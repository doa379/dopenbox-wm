.include "config.mk"

FLAG=Release
CFLAGS=${REL_CFLAGS}
LFLAGS=${REL_LFLAGS}
EXEC=${.CURDIR}/${REL}

.if "$(DEBUG)" == "1"
FLAG=Debug
CFLAGS=${DBG_CFLAGS}
LFLAGS=${DBG_LFLAGS}
EXEC=${.CURDIR}/${DBG}
.endif

OBJ=${SRC:.cpp=.o}

.SUFFIXES: .cpp .h .o
# These paths must pre-exist
.PATH.cpp: ${.CURDIR}/src
.PATH.h: ${.CURDIR}/inc
.PATH.o: ${.CURDIR}/obj
.OBJDIR: ${.CURDIR}/obj

.POSIX:

all: init ${EXEC}

init:
	@echo Build ${FLAG}

.cpp.o:
	@echo Build ${.TARGET}...
	@${CPPC} ${FLAGS} ${CFLAGS} ${INCS} ${.IMPSRC} -c -o ${.TARGET}

${OBJ}: ${HDR_CONFIG} ${HDR_SRC}

${EXEC}: ${OBJ}
	@echo Link ${OBJ}...
	@${CPPC} ${FLAGS} ${LIBSPATH} ${LIBS} ${LFLAGS} ${OBJ} -o ${.TARGET}
	@echo $@

clean:
	@echo Cleaning...
	rm -f ${OBJ}
	rm -f ${.CURDIR}/${REL}
	rm -f ${.CURDIR}/${DBG}

.PHONY: all init clean
